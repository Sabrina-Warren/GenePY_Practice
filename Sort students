# Sort students

# In this exercise we represent students as a pair of (mark, full_name), so a tuple of two elements.
# Part 1: Write a function named sort_by_mark that take as argument a list of students and returns a copy of it sorted by mark in descending order.
# Part 2: Write a function named sort_by_name that take as argument a list of students and returns a copy of it sorted by name in ascending order.

my_class = [(25, "Shannon"), (50, "Alan"), (75, "Ada")]

def sort_by_mark(my_class):
    
    for num in range(len(my_class)):  # Bubble sort to sort by the highest score in the list using the first index of the passed tuple
        for num2 in range(len(my_class)):
            if (my_class[num][0] > my_class[num2][0]):
                temp = my_class[num]
                my_class[num] = my_class[num2]
                my_class[num2] = temp
                
    return my_class

def sort_by_name(my_class):
    """
    I would like to figure out a way to do this sort with this kind of reference to the tuple in the for loops rather than its index in the list.

    for num in my_class:
       for num2 in my_class:
           if num[1] > num2[1]:
               temp = num
               num = num2
               num2 = temp
    """
    
    for num in range(len(my_class)):  # Bubble sort to sort nams by alphabetical order in the list using the second index of the passed tuple
        for num2 in range(len(my_class)):
            if (my_class[num][1] < my_class[num2][1]):
                temp = my_class[num]
                my_class[num] = my_class[num2]
                my_class[num2] = temp
    
    return my_class

print(sort_by_mark(my_class))
print(sort_by_name(my_class))
